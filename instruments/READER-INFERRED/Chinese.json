{
  "instrument": "READER-INFERRED",
  "language": "Chinese",
  "administered_to": "readers, per text, to infer the writer's values (shortened item set)",
  "n_items": 26,
  "items": [
    {
      "id": "CA1",
      "dimension": "Care",
      "text": "我们应该关心并帮助那些正在受苦的人。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "CA2",
      "dimension": "Care",
      "text": "我们应该对处于痛苦中的人表示同情。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "EQ1",
      "dimension": "Equality",
      "text": "金钱应该被平等分配，因为这将带来一个更好、更公平的社会。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "EQ2",
      "dimension": "Equality",
      "text": "资源应该在每个人之间平等分配，无论他们的贡献如何。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "PRO1",
      "dimension": "Proportionality",
      "text": "努力工作应该带来更高的经济回报。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "PRO2",
      "dimension": "Proportionality",
      "text": "根据一个人的表现和成就给予认可，对其不诚实的行为应该进行惩罚。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "LOY1",
      "dimension": "Loyalty",
      "text": "每个人都应该热爱自己的社区。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "LOY2",
      "dimension": "Loyalty",
      "text": "忠于自己的国家是很重要的。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "AUT1",
      "dimension": "Authority",
      "text": "我们需要维护传统价值观。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "AUT2",
      "dimension": "Authority",
      "text": "拥有一位强有力的领导者对社会是有益的。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "AUT3",
      "dimension": "Authority",
      "text": "服从父母是一种重要的美德。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "PUR1",
      "dimension": "Purity",
      "text": "人体应被视为一座庙宇，承载着内在的神圣之物。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "PUR2",
      "dimension": "Purity",
      "text": "当人们觉得说脏话无所谓时，我会感到沮丧。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "PUR3",
      "dimension": "Purity",
      "text": "如果我发现熟人有不自然但无害的恋物癖，我会对他们感到不舒服。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "PUR4",
      "dimension": "Purity",
      "text": "人们应当尽量使用天然药物，而不是人造的化学药物。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "COLL1",
      "dimension": "Individualism-Collectivism",
      "text": "群体的需求和成功应优先于个人的愿望和成就。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "COLL2",
      "dimension": "Individualism-Collectivism",
      "text": "我们应该将对群体的忠诚和集体福祉置于个人目标之上。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "PD1",
      "dimension": "Power Distance",
      "text": "决策主要应该由高层职位的人负责，而不需要过多考虑低层职位的意见。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "PD2",
      "dimension": "Power Distance",
      "text": "处于较低职位的人不应该质疑高层职位的决策，也不应该独自承担重大任务。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "UA1",
      "dimension": "Uncertainty Avoidance",
      "text": "每个人都应该通过清晰解释的每一步明确知道自己该做什么。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "UA2",
      "dimension": "Uncertainty Avoidance",
      "text": "法规和规则很重要，这样我可以知道我应该做什么。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "UA3",
      "dimension": "Uncertainty Avoidance",
      "text": "我认为标准化的工作流程是有益的。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "LTO1",
      "dimension": "Long-Term Orientation",
      "text": "我们应该明智地管理资金并考虑未来。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "LTO2",
      "dimension": "Long-Term Orientation",
      "text": "即使很困难，你也应该坚持自己的目标，并为接下来的事情努力奋斗。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "GE1",
      "dimension": "Gender Egalitarianism",
      "text": "男性和女性在职业和解决问题的环境中有着不同的角色和优势。",
      "scale_size": 5,
      "min_label": "强烈不同意",
      "max_label": "强烈同意"
    },
    {
      "id": "QUAL",
      "dimension": "Individualism-Collectivism",
      "text": "个人的愿望和成就应优先于群体的需求和成功。",
      "scale_size": 5,
      "min_label": "强烈不同意",
